{
  "name": "snapper-frontend",
  "private": true,
  "version": "1.5.6",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mateusz-klatt/snapper-frontend.git"
  },
  "homepage": "https://github.com/mateusz-klatt/snapper-frontend#readme",
  "bugs": {
    "url": "https://github.com/mateusz-klatt/snapper-frontend/issues"
  },
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache --max-warnings=0 .",
    "lint:fix": "eslint --cache . --fix",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dead-code": "knip",
    "dead-code:fix": "knip --fix",
    "check:no-comments": "node scripts/check-no-comments.mjs",
    "check:no-comments:strict": "node scripts/check-no-comments.mjs --strict",
    "check:i18n": "node scripts/check-i18n.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "test:run:serial": "vitest run --maxWorkers=1 --no-file-parallelism",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage && pnpm test:scripts:coverage && node -e \"const fs=require('node:fs');fs.appendFileSync('coverage/lcov.info',fs.readFileSync('coverage/scripts-lcov.info'))\"",
    "test:coverage:serial": "vitest run --coverage --maxWorkers=1 --no-file-parallelism && pnpm test:scripts:coverage && node -e \"const fs=require('node:fs');fs.appendFileSync('coverage/lcov.info',fs.readFileSync('coverage/scripts-lcov.info'))\"",
    "test:scripts:coverage": "node -e \"require('node:fs').mkdirSync('coverage',{recursive:true})\" && node --test --experimental-test-coverage --test-coverage-lines=100 --test-coverage-functions=100 --test-coverage-branches=100 --test-coverage-include=scripts/build-screenshot-index.mjs --test-coverage-include=scripts/check-i18n.mjs --test-coverage-include=scripts/check-no-comments.mjs --test-coverage-include=scripts/vendor-icons.mjs --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/scripts-lcov.info scripts/sonar-coverage.test.mjs",
    "prepush": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm check:no-comments:strict && pnpm check:i18n && pnpm test:coverage",
    "prepush:fix": "pnpm format && pnpm lint --fix && pnpm typecheck && pnpm check:no-comments:strict && pnpm check:i18n && pnpm test:coverage",
    "gen:api-types": "openapi-typescript build/openapi.json -o src/types/api.generated.ts --export-type",
    "gen:api-types:from-monorepo": "openapi-typescript ../build/openapi.json -o src/types/api.generated.ts --export-type",
    "gen:ws-types": "json2ts build/ws-schemas.json -o src/types/ws.generated.ts --additionalProperties false",
    "gen:ws-types:from-monorepo": "json2ts ../build/ws-schemas.json -o src/types/ws.generated.ts --additionalProperties false",
    "gen": "node scripts/gen-from-backend.mjs",
    "icons:vendor": "node scripts/vendor-icons.mjs",
    "bundle:check": "node scripts/check-bundle-budget.mjs",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "e2e:ui": "playwright test --config e2e/playwright.config.ts --ui",
    "e2e:debug": "playwright test --config e2e/playwright.config.ts --debug",
    "e2e:report": "playwright show-report playwright-report"
  },
  "dependencies": {
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@tanstack/react-query": "^5.102.8",
    "clsx": "^2.1.1",
    "country-flag-emoji-polyfill": "^0.1.10",
    "i18next": "^26.4.2",
    "i18next-resources-to-backend": "^1.2.3",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^1.44.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hot-toast": "^2.6.0",
    "react-i18next": "^17.0.13",
    "uuid": "^14.0.2",
    "zod": "^4.6.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@mermaid-js/mermaid-cli": "^11.17.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-istanbul": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "json-schema-to-typescript": "^16.0.0",
    "json-schema-to-zod": "^2.8.1",
    "knip": "^6.35.1",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "puppeteer": "^25.10.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
